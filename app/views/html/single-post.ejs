        <article class="single-post_content">
          <h1 class="single-post_title" id="post-title"></h1>
          <img src="" alt="" class="single-post_image" id="post-image" />
          <div class="single-post_body" id="post-content"></div>
          <div class="single-post_video" id="post-video" hidden></div>
          <div class="single-post_downloads" id="post-downloads" hidden></div>
        </article>

        <aside class="single-post_sidebar">
          <h2 class="single-post_sidebar_title">دسترسی سریع</h2>
          <a href="#" class="single-post_sidebar_link" id="back-link"></a>
        </aside>
      </div>
    </div>
  </main>

  <!-- toggle btn -->
  <button id="themeToggleBtn" class="theme-toggle" aria-label="تغییر تم">
