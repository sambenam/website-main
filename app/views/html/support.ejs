  <!-- MAIN CONTENT -->
  <main class="main">
    <div class="main-container">
      <!-- PAGE HEADER -->
      <div class="page-header">
        <h1 class="page-title">تماس با ما</h1>
        <p class="page-subtitle">راه‌های ارتباط با حسابیار</p>
      </div>

      <!-- CONTACT INFO -->
      <div class="contact-info">
        <div class="contact-card">
          <i class="fa-solid fa-phone"></i>
          <h3>تماس تلفنی</h3>
          <p>۰۲۱-۱۲۳۴۵۶۷۸</p>
          <p>شنبه تا چهارشنبه: ۹ صبح تا ۵ عصر</p>
        </div>
        <div class="contact-card">
          <i class="fa-solid fa-envelope"></i>
          <h3>ایمیل</h3>
          <p>info@hesabyar.com</p>
          <p>پاسخگویی در کمتر از ۲۴ ساعت</p>
        </div>
        <div class="contact-card">
          <i class="fa-solid fa-location-dot"></i>
          <h3>آدرس</h3>
          <p>تهران، خیابان ولیعصر، نرسیده به مترو زین‌الدین</p>
        </div>
      </div>

      <!-- CONTACT FORM -->
      <div class="contact-form-section">
        <h2 class="section-title">
          <i class="fa-solid fa-paper-plane"></i>
          ارسال پیام
        </h2>
        <form class="contact-form" id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="name">نام و نام خانوادگی</label>
              <input type="text" id="name" placeholder="نام خود را وارد کنید" required />
            </div>
            <div class="form-group">
              <label for="email">ایمیل</label>
              <input type="email" id="email" placeholder="ایمیل خود را وارد کنید" required />
            </div>
          </div>
          <div class="form-group">
            <label for="subject">موضوع</label>
            <select id="subject" required>
              <option value="" disabled selected>موضوع را انتخاب کنید</option>
              <option value="question">سوال آموزشی</option>
              <option value="feedback">نظر یا پیشنهاد</option>
              <option value="cooperation">همکاری</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">پیام</label>
            <textarea id="message" placeholder="پیام خود را بنویسید..." rows="6" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-paper-plane"></i>
            ارسال پیام
          </button>
        </form>
      </div>

      <!-- REPORT A VIOLATION
             Moved out of the "موضوع" dropdown and given its own section: a
             violation report is a different kind of thing from a question or
             a suggestion, and it does not belong in the same list. It also
             reaches the panel on its own channel, as a "گزارش تخلف"
             notification that only managers can see. -->
      <div class="contact-form-section report-abuse-section">
        <h2 class="section-title">
          <i class="fa-solid fa-triangle-exclamation"></i>
          گزارش تخلف
        </h2>
        <p class="report-abuse-note">
          اگر محتوای نامناسب، تخلف از قوانین یا سوءاستفاده‌ای مشاهده کردید،
          از این بخش به ما اطلاع دهید. گزارش‌ها جداگانه و محرمانه بررسی
          می‌شوند.
        </p>

        <form class="contact-form report-abuse-form" id="reportAbuseForm">
          <div class="form-row">
            <div class="form-group">
              <label for="reportName">نام و نام خانوادگی</label>
              <input type="text" id="reportName" placeholder="نام خود را وارد کنید" required />
            </div>
            <div class="form-group">
              <label for="reportEmail">ایمیل</label>
              <input type="email" id="reportEmail" placeholder="ایمیل خود را وارد کنید" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="reportKind">نوع تخلف</label>
              <select id="reportKind" required>
                <option value="" disabled selected>نوع تخلف را انتخاب کنید</option>
                <option value="content">محتوای نامناسب</option>
                <option value="copyright">نقض حق نشر</option>
                <option value="abuse">سوءاستفاده یا توهین</option>
                <option value="fraud">کلاهبرداری</option>
                <option value="other">سایر موارد</option>
              </select>
            </div>
            <div class="form-group">
              <label for="reportSeverity">درجه اهمیت</label>
              <select id="reportSeverity" required>
                <option value="low">کم</option>
                <option value="medium" selected>متوسط</option>
                <option value="high">زیاد</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="reportSubject">مورد گزارش‌شده</label>
            <input type="text" id="reportSubject" placeholder="مثلاً: نام دوره، صفحه یا کاربر موردنظر" required />
          </div>

          <div class="form-group">
            <label for="reportEvidenceFile">
              بارگذاری مدرک <span class="field-optional">(اختیاری)</span>
            </label>
            <div class="evidence-upload">
              <input type="file" id="reportEvidenceFile" accept="image/*" hidden />
              <button type="button" class="evidence-upload__btn" id="reportEvidenceChoose">
                <i class="fa-solid fa-image"></i>
                انتخاب تصویر از دستگاه
              </button>
              <button type="button" class="evidence-upload__clear" id="reportEvidenceClear" hidden>
                <i class="fa-solid fa-xmark"></i>
                حذف
              </button>
            </div>
            <img id="reportEvidencePreview" class="evidence-upload__preview" alt="پیش‌نمایش مدرک" hidden />
            <small class="evidence-upload__hint" id="reportEvidenceHint">
              فقط تصویر پذیرفته می‌شود (JPG، PNG، WebP یا GIF) و حداکثر ۳۰۰ کیلوبایت.
            </small>
            <input type="hidden" id="reportEvidence" />
          </div>

          <div class="form-group">
            <label for="reportDescription">شرح تخلف</label>
            <textarea id="reportDescription" rows="5" placeholder="توضیح دهید چه چیزی مشاهده کردید..."
              required></textarea>
          </div>

          <button type="submit" class="btn btn-outline-danger btn-lg" id="reportAbuseBtn">
            <i class="fa-solid fa-flag"></i>
            ثبت گزارش تخلف
          </button>
        </form>
      </div>

      <!-- FAQ SECTION -->
      <section class="faq-section">
        <h2 class="section-title">
          <i class="fa-solid fa-question-circle"></i>
          سوالات متداول
        </h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question">
              <i class="fa-solid fa-chevron-down"></i>
              چگونه می‌توانم در سایت ثبت‌نام کنم؟
            </button>
            <div class="faq-answer">
              <p>
                برای ثبت‌نام، روی دکمه "عضویت رایگان" در سایت کلیک کنید و
                اطلاعات خود را وارد نمایید.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              <i class="fa-solid fa-chevron-down"></i>
              آیا مطالب سایت رایگان هستند؟
            </button>
            <div class="faq-answer">
              <p>
                بله، تمام مطالب سایت حسابیار به صورت رایگان در دسترس هستند.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              <i class="fa-solid fa-chevron-down"></i>
              چگونه می‌توانم فایل‌ها را دانلود کنم؟
            </button>
            <div class="faq-answer">
              <p>
                برای دانلود فایل‌ها، ابتدا در سایت ثبت‌نام کنید و سپس به صفحه
                مورد نظر مراجعه نمایید.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              <i class="fa-solid fa-chevron-down"></i>
              آیا گواهینامه ارائه می‌شود؟
            </button>
            <div class="faq-answer">
              <p>
                بله، پس از گذراندن دوره‌ها، می‌توانید گواهینامه شرکت در دوره
                را دریافت نمایید.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- toggle btn -->
  <button id="themeToggleBtn" class="theme-toggle" aria-label="تغییر تم">
    <span class="theme-toggle-track-icons"><span>🌙</span><span>☀️</span></span>
    <span class="theme-toggle-knob">
      <span class="icon-sun">☀️</span>
      <span class="icon-moon">🌙</span>
    </span>
  </button>

